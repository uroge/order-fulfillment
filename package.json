{
  "name": "@order-fulfillment/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:api-gateway": "nx serve api-gateway",
    "start:auth-service": "nx serve auth-service",
    "start:orders-service": "nx serve orders-service",
    "auth:migration:generate": "TS_NODE_PROJECT=apps/auth-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d apps/auth-service/src/database/data-source.ts apps/auth-service/src/database/migrations/InitAuth",
    "auth:migration:run": "TS_NODE_PROJECT=apps/auth-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/auth-service/src/database/data-source.ts",
    "orders:migration:generate": "TS_NODE_PROJECT=apps/orders-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d apps/orders-service/src/database/data-source.ts apps/orders-service/src/database/migrations/InitOrders",
    "orders:migration:run": "TS_NODE_PROJECT=apps/orders-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/orders-service/src/database/data-source.ts",
    "auth:seed": "TS_NODE_PROJECT=apps/auth-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/auth-service/src/database/seed.ts",
    "orders:seed": "TS_NODE_PROJECT=apps/orders-service/tsconfig.migrations.json node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/orders-service/src/database/seed.ts",
    "dev:auth": "yarn auth:migration:run && yarn auth:seed && yarn start:auth-service",
    "dev:orders": "yarn orders:migration:run && yarn orders:seed && yarn start:orders-service"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/nest": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "dotenv": "^16.6.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typeorm-ts-node-commonjs": "0.3.20",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
