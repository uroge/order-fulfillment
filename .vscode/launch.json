{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug order-fulfillment with Nx",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["nx", "serve", "order-fulfillment"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/order-fulfillment/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
